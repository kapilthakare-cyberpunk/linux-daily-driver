{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-scheduler"
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--cdp-endpoint",
        "http://127.0.0.1:9222"
      ],
      "enabled": true
    }
  }
}
